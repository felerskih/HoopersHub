@page "/weights"
@using Domain.Entity
@using Application.Services
@inject WeightsStore _weightsStore

<h1 class="text-2xl font-bold text-gray-200 mb-4">Weights</h1>

<EditForm Model="weights" OnValidSubmit="UpdateWeights" FormName="WeightsForm">
    <div class="flex flex-col gap-4 p-6 bg-gray-900 rounded-2xl shadow-lg max-w-md">
        <div class="flex items-center justify-between border-b border-gray-700 pb-2">
            <label class="text-sm uppercase tracking-widest text-gray-400">Points</label>
            <InputNumber @bind-Value="weights.Points" class="w-20 text-center bg-transparent border-b border-gray-600 focus:border-yellow-400 focus:outline-none text-gray-200 rounded" />
        </div>
        <div class="flex items-center justify-between border-b border-gray-700 pb-2">
            <label class="text-sm uppercase tracking-widest text-gray-400">Offensive Rebounds</label>
            <InputNumber @bind-Value="weights.OffensiveRebounds" class="w-20 text-center bg-transparent border-b border-gray-600 focus:border-yellow-400 focus:outline-none text-gray-200 rounded" />
        </div>
        <div class="flex items-center justify-between border-b border-gray-700 pb-2">
            <label class="text-sm uppercase tracking-widest text-gray-400">Defensive Rebounds</label>
            <InputNumber @bind-Value="weights.DefensiveRebounds" class="w-20 text-center bg-transparent border-b border-gray-600 focus:border-yellow-400 focus:outline-none text-gray-200 rounded" />
        </div>
        <div class="flex items-center justify-between border-b border-gray-700 pb-2">
            <label class="text-sm uppercase tracking-widest text-gray-400">Rebounds</label>
            <InputNumber @bind-Value="weights.Rebounds" class="w-20 text-center bg-transparent border-b border-gray-600 focus:border-yellow-400 focus:outline-none text-gray-200 rounded" />
        </div>
        <div class="flex items-center justify-between border-b border-gray-700 pb-2">
            <label class="text-sm uppercase tracking-widest text-gray-400">Assists</label>
            <InputNumber @bind-Value="weights.Assists" class="w-20 text-center bg-transparent border-b border-gray-600 focus:border-yellow-400 focus:outline-none text-gray-200 rounded" />
        </div>
        <div class="flex items-center justify-between border-b border-gray-700 pb-2">
            <label class="text-sm uppercase tracking-widest text-gray-400">Turnovers</label>
            <InputNumber @bind-Value="weights.Turnovers" class="w-20 text-center bg-transparent border-b border-gray-600 focus:border-yellow-400 focus:outline-none text-gray-200 rounded" />
        </div>
        <div class="flex items-center justify-between border-b border-gray-700 pb-2">
            <label class="text-sm uppercase tracking-widest text-gray-400">Steals</label>
            <InputNumber @bind-Value="weights.Steals" class="w-20 text-center bg-transparent border-b border-gray-600 focus:border-yellow-400 focus:outline-none text-gray-200 rounded" />
        </div>
        <div class="flex items-center justify-between border-b border-gray-700 pb-2">
            <label class="text-sm uppercase tracking-widest text-gray-400">Blocks</label>
            <InputNumber @bind-Value="weights.Blocks" class="w-20 text-center bg-transparent border-b border-gray-600 focus:border-yellow-400 focus:outline-none text-gray-200 rounded" />
        </div>

        <button type="submit" class="mt-2 px-4 py-2 bg-gray-700 hover:bg-gray-600 text-gray-200 text-sm font-semibold rounded-lg transition-colors">
            Save Weights
        </button>

    </div>
</EditForm>

@code {
    [SupplyParameterFromForm]
    private RatingWeights weights { get; set; } = new();

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override void OnInitialized()
    {
        if (HttpContext.Request.Method == "GET")
        {
            weights = _weightsStore.GetWeights();
        }
    }

    private void UpdateWeights()
    {
        _weightsStore.UpdateWeights(weights);
    }
}